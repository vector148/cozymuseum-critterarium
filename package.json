{
  "name": "cozymuseum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js && node scripts/generate-search-assets.mjs",
    "preview": "vite preview --config vite.config.js",
    "test": "node --test",
    "commitlint": "commitlint --last --verbose",
    "bio": "node scripts/cozymuseum.mjs",
    "verify": "node --test tests/biodiversity/*.test.js tests/browser/*.test.js tests/server/atlas-api.test.js tests/launcher.test.js tests/search-assets.test.js && npm run build && npm run bio -- doctor",
    "prepare": "husky"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "husky": "^9.1.6",
    "vite": "^5.4.2"
  }
}
