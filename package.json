{
  "name": "cozymuseum",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "release:verify": "node scripts/verify-cleanroom-release.mjs .",
    "desktop:build": "node scripts/build-windows-installer.mjs",
    "test": "node --test",
    "commitlint": "commitlint --last --verbose",
    "bio": "node scripts/cozymuseum.mjs",
    "verify": "node --test && npm run build && npm run bio -- doctor && npm run release:verify",
    "prepare": "husky"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "husky": "^9.1.6",
    "sharp": "^0.35.3",
    "vite": "^8.2.2"
  }
}
